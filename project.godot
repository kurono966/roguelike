; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Roguelike"
run/main_scene="res://ui/start_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"
config/run/main_scene="res://ui/start_menu.tscn"

[autoload]

SaveManager="res://save_manager.gd"
GameState="res://autoloads/game_state.gd"
InputManager="res://autoloads/input_manager.gd"
EquipmentEvents="res://autoloads/equipment_events.gd"
PlayerUi="*res://ui/PlayerUI.tscn"
LogUI="*res://ui/log_ui.tscn"
GameUI="*res://ui/game_ui.tscn"

[gui]

theme/custom_font="uid://cpjtgt4w3rgjc"
theme/custom_theme="res://ui/themes/main_theme.tres"
theme/default_font_size=16

[internationalization]

locale/test="ja"
locale/fallback="ja"

[rendering]

renderer/rendering_method.mobile="forward_plus"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.03, 1)
